# Site source stays tracked: src, messages, content, public, and project config.
# Ignore only what is generated, secret, or local working material.

# Dependencies and build output
/node_modules
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Secrets
.env*
!.env.example
*.pem

# Local briefs and reference images. These are not served by the site.
/myproject/
/my project/
/reference/

# Tooling
.DS_Store
.vercel
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
